<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EQLWikiEditorAssistant.Core\EQLWikiEditorAssistant.Core.csproj" />
    <ProjectReference Include="..\..\src\EQLWikiEditorAssistant.Ocr\EQLWikiEditorAssistant.Ocr.csproj" />
    <ProjectReference Include="..\EQLWikiEditorAssistant.TestSupport\EQLWikiEditorAssistant.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct reference required, not just transitive via .Ocr: RapidOcrNet's bundled .onnx models only copy
         reliably to an executable's own output directory this way. See CLAUDE.md. -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

</Project>
