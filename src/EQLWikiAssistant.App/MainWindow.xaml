<Window x:Class="EQLWikiAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLWikiAssistant.App"
        mc:Ignorable="d"
        Title="EQLWiki Editor Assistant" Height="900" Width="1300">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="#444" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- A plain header rather than a ToolBar: WPF's ToolBar restyles a CheckBox into a flat toggle with no box,
             which makes a setting look like a button, and adds an overflow chevron that never has anything in it. -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CaptureButton" Click="OnCaptureClick" Padding="12,4" FontWeight="SemiBold"
                        Content="Capture now" ToolTip="Capture the game window and check every item window in it" />
                <CheckBox x:Name="ReCheckBox" Content="Re-check anyway" VerticalAlignment="Center" Margin="16,0,0,0"
                          Checked="OnReCheckChanged" Unchecked="OnReCheckChanged"
                          ToolTip="Ask the wiki even for items the ledger has already settled" />
                <TextBlock x:Name="HotKeyLabel" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#666" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="LedgerText" Foreground="#666" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Every window found in the frame, including the ones nothing could be done with: a window the tool
                 refused is exactly what the user needs to be told about. -->
            <ListBox x:Name="ResultsList" Grid.Column="0" SelectionChanged="OnResultSelected"
                     HorizontalContentAlignment="Stretch" BorderThickness="0,0,1,0" BorderBrush="#DDD">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,5">
                            <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                <TextBlock Text="  •  done" FontSize="11" Foreground="Gray"
                                           Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEE" />

            <!-- Shown only when nothing is selected. It is a separate element rather than a placeholder inside the
                 detail panel because a binding against a null DataContext cannot resolve at all: WPF then falls back
                 to the property's default, and every `Visibility` below silently reverts to Visible — which rendered
                 the entire empty scaffold, lore panel and buttons included. -->
            <TextBlock Grid.Column="2" x:Name="EmptyState" TextWrapping="Wrap" MaxWidth="420" Foreground="#888"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="Open an item window in game and press Ctrl+Shift+E.&#10;&#10;Every item window in the capture is checked against the wiki and listed on the left." />

            <ScrollViewer Grid.Column="2" x:Name="DetailScroller" VerticalScrollBarVisibility="Auto"
                          Padding="16,10,16,16" Visibility="Collapsed">
                <StackPanel x:Name="DetailPanel" DataContext="{Binding SelectedItem, ElementName=ResultsList}">
                    <TextBlock Text="{Binding ItemName}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="  —  " Foreground="#AAA"
                                   Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Click="OnOpenPageClick">
                                <TextBlock Text="{Binding PageTitle}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Warnings first and unmissable. A flagged gap is the product here; silently-wrong data on a
                         public wiki is the failure this whole tool exists to avoid. -->
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,12,0,0"
                                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="1"
                                        CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#5D4200" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="What differs" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}" />
                    <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1"
                              BorderBrush="#DDD" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="1.2*" />
                            <DataGridTextColumn Header="In game" Binding="{Binding Captured}" Width="1.5*" />
                            <DataGridTextColumn Header="On the wiki" Binding="{Binding OnWiki}" Width="1.5*" />
                            <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="Auto" />
                            <!-- A template column so the note wraps. As a text column it truncated mid-sentence,
                                 which loses the part explaining *why* the tool concluded what it did. -->
                            <DataGridTemplateColumn Header="Note" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="2,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{Binding Foreground}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Lore gets its own panel because it is the one field a grid cell cannot show: it is a
                         paragraph, and the decision is a judgement about prose the user has to actually read. The
                         tool never overwrites it, so this is purely "do you still like what the page says?". -->
                    <StackPanel Visibility="{Binding HasLoreToCompare, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Lore — check you are happy with the page's wording"
                                   Style="{StaticResource SectionHeading}" />
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                                   Text="These differ. The tool does not overwrite lore, so the page keeps its own wording unless you change it by hand." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                                    Padding="8" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="On the wiki (kept)" FontWeight="SemiBold" Foreground="SeaGreen"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding LoreOnWiki}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                                    Padding="8" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="In game (captured)" FontWeight="SemiBold" Foreground="#555"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding LoreInGame}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="The edit" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}" />
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Diff}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding Background}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LineNumbers}" FontFamily="Consolas"
                                                   FontSize="11" Foreground="#AAA" Margin="4,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas"
                                                   FontSize="12" Foreground="{Binding Foreground}"
                                                   TextWrapping="Wrap" Margin="0,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Expander Header="Edit the wikitext before saving" Margin="0,10,0,0"
                              Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Wikitext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" Height="260" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                    </Expander>

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Edit summary" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save to the wiki" Click="OnCommitClick" Padding="14,5"
                                    FontWeight="SemiBold" IsEnabled="{Binding CanAct}" />
                            <Button Content="Skip for now" Click="OnSkipClick" Padding="14,5" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanSkip}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The only way a flagged item becomes done. Without it, an item whose page the user has
                         decided is correct stays flagged and re-fetches on every capture forever. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding CanMarkChecked, Converter={StaticResource BoolToVis}}">
                        <Button Content="Looks right — mark as checked" Click="OnMarkCheckedClick" Padding="14,5" />
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666" TextWrapping="Wrap"
                                   Text="Settles what is flagged above, without changing the page, so this item stops coming back." />
                    </StackPanel>

                    <TextBlock Text="{Binding Outcome}" Foreground="SeaGreen" FontWeight="SemiBold"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" />

                    <!-- The formatting follow-up: its own edit, never folded into the data one, because a single
                         reformatting commit with no data changes is what makes page history reviewable. -->
                    <StackPanel Visibility="{Binding HasFormatting, Converter={StaticResource BoolToVis}}"
                                Margin="0,18,0,0">
                        <Border Background="#EEF4FB" BorderBrush="#BBD4EC" BorderThickness="1" CornerRadius="3"
                                Padding="10,7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="#1B4A75"
                                           Text="The page can also be tidied — as a separate edit" />
                                <TextBlock TextWrapping="Wrap" Foreground="#33618C" Margin="0,3,0,0"
                                           Text="Laid out to the Item Page Blueprint, with no data changes. Committing this separately keeps the edit above readable in the page's history." />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding FormattingDiff}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="{Binding Background}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LineNumbers}" FontFamily="Consolas"
                                                       FontSize="11" Foreground="#AAA" Margin="4,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas"
                                                       FontSize="12" Foreground="{Binding Foreground}"
                                                       TextWrapping="Wrap" Margin="0,0,4,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save the formatting" Click="OnCommitFormattingClick" Padding="14,5"
                                    IsEnabled="{Binding CanCommitFormatting}" />
                            <TextBlock Text="{Binding FormattingOutcome}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Foreground="SeaGreen" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="What was captured" Style="{StaticResource SectionHeading}" />
                    <Image x:Name="WindowImage" Stretch="None" HorizontalAlignment="Left" Margin="0,2,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
