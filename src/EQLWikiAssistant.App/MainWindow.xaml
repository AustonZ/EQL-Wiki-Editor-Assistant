<Window x:Class="EQLWikiAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLWikiAssistant.App"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="EQLWiki Editor Assistant" Height="900" Width="1300" MinWidth="650" MinHeight="400"
        Style="{StaticResource DarkWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- **Item data and wikitext are monospaced; the interface is not** (user, 2026-09-28). Two reasons, and the
             first is correctness: in a proportional face `I` and `l` are near-identical, so the tool would report a
             lore difference the user could not see — real case, `Black Chain Bridle`. The second is that it makes
             plain at a glance which text is going to, or coming from, the wiki and which is just the app talking. -->
        <Style x:Key="ItemData" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- One size for every icon tile: a 40x40 wiki file at 4x. -->
        <sys:Double x:Key="IconTileSize">160</sys:Double>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- A plain header rather than a ToolBar: WPF's ToolBar restyles a CheckBox into a flat toggle with no box,
             which makes a setting look like a button, and adds an overflow chevron that never has anything in it. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CaptureButton" Click="OnCaptureClick" Padding="12,4" FontWeight="SemiBold"
                        Content="Capture now" ToolTip="Capture the game window and check every item window in it" />
                <!-- Beside the button it is the shortcut for (user, 2026-10-07). -->
                <TextBlock x:Name="HotKeyLabel" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                <CheckBox x:Name="ReCheckBox" Content="Re-check anyway" VerticalAlignment="Center" Margin="16,0,0,0"
                          Checked="OnReCheckChanged" Unchecked="OnReCheckChanged"
                          ToolTip="Ask the wiki even for items the ledger has already settled" />
                <Button x:Name="LedgerButton" Click="OnLedgerClick" Padding="12,4" Margin="16,0,0,0"
                        Content="History…"
                        ToolTip="Everything checked so far, and what still needs attention" />
                <Button x:Name="SettingsButton" Click="OnSettingsClick" Padding="12,4" Margin="8,0,0,0"
                        Content="Settings…"
                        ToolTip="The game's UI font, the wiki login, and the wiki mapping" />

                <!-- A capture takes tens of seconds, most of it the full-frame OCR pass. A disabled button and a
                     status line were too quiet to read as "working" (user, 2026-09-28). -->
                <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Margin="20,0,0,0" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="BusyLabel" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <!-- The attention count opens History filtered to exactly those rows (user, 2026-10-07). -->
                <TextBlock Foreground="{StaticResource TextMutedBrush}">
                    <Run x:Name="LedgerTotalRun" /><Run x:Name="LedgerSeparatorRun" /><Hyperlink
                        x:Name="AttentionLink" Click="OnAttentionClick"
                        ToolTip="Show them in History"><Run x:Name="AttentionRun" /></Hyperlink>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Every window found in the frame, including the ones nothing could be done with: a window the tool
                 refused is exactly what the user needs to be told about. -->
            <DockPanel Grid.Column="0">
            <!-- Closing everything at once, for the end of a session. Like closing one, it changes nothing on the
                 wiki or in the ledger: a tab is only a view of a capture. -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,1"
                    Padding="8,4" x:Name="ResultsHeader" Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Right">
                    <Hyperlink Click="OnCloseAllClick" ToolTip="Close every item">Close all</Hyperlink>
                </TextBlock>
            </Border>
            <ListBox x:Name="ResultsList" SelectionChanged="OnResultSelected"
                     HorizontalContentAlignment="Stretch" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrushKey}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,0" ToolTip="{Binding CaptureTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,5">
                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal">
                                    <!-- A settled item reads "Done" in green here rather than keeping its orange
                                         status with a grey marker beside it: the list is scanned to find what still
                                         needs attention, so done is what has to be obvious (user, 2026-09-29). -->
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="  •  lore" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               Visibility="{Binding HasCapturedLore, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- The list accumulates across captures, so finishing with an item has to be an
                                 explicit act rather than something the next capture does for you. -->
                            <!-- The full height of the row, so the cross sits centred and is easy to hit (user,
                                 2026-10-07). The row's vertical margin lives on the text for the same reason. -->
                            <Button Grid.Column="1" Content="✕" Click="OnCloseResultClick" Padding="8,0"
                                    Style="{StaticResource QuietButton}"
                                    VerticalAlignment="Stretch" ToolTip="Close this item" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- Shown only when nothing is selected. It is a separate element rather than a placeholder inside the
                 detail panel because a binding against a null DataContext cannot resolve at all: WPF then falls back
                 to the property's default, and every `Visibility` below silently reverts to Visible — which rendered
                 the entire empty scaffold, lore panel and buttons included. -->
            <TextBlock Grid.Column="2" x:Name="EmptyState" TextWrapping="Wrap" MaxWidth="420" Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="Open an item window in game and press Ctrl+Shift+E.&#10;&#10;Every item window in the capture is checked against the wiki and listed on the left." />

            <!-- No padding on the scroller itself: it sat inside the scrolling area, so clipped content stopped short
                 of the border above and below (user, 2026-10-07). The panel's own margin scrolls with it instead. -->
            <ScrollViewer Grid.Column="2" x:Name="DetailScroller" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel x:Name="DetailPanel" DataContext="{Binding SelectedItem, ElementName=ResultsList}"
                            Margin="16,10,16,16">
                    <TextBlock Text="{Binding ItemName}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="  —  " Foreground="{StaticResource TextDimBrush}"
                                   Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Click="OnOpenPageClick">
                                <TextBlock Text="{Binding PageTitle}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding LedgerNote}" Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"
                                   Visibility="{Binding HasLedgerNote, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- **The capture comes first, above everything else** (user, 2026-10-01): the game is the
                         source, so the panel reads from the source downward towards the finished wikitext. The
                         icons share this row rather than taking a section of their own further down — there is
                         spare width beside a ~400px window crop, and vertical space is what this panel runs out
                         of. A WrapPanel is what makes that safe: on a narrow window the icons drop below the
                         screenshot instead of being clipped. -->
                    <TextBlock Text="What was captured" Style="{StaticResource SectionHeading}" />
                    <WrapPanel Orientation="Horizontal">
                        <Image x:Name="WindowImage" Stretch="None" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <!-- The Lore capture sits beside the Description one rather than replacing it, so both
                             halves of a two-capture item stay visible together. -->
                        <Image x:Name="LoreImage" Stretch="None" VerticalAlignment="Top" Margin="12,2,0,0" />

                        <!-- Both icons, whatever the verdict. The comparison is perceptual and has limits — it
                             declines near-black sprites and occasionally flags a good one — and every one of those
                             outcomes is cheap to settle if the user can just look, and expensive if they cannot. It
                             also makes a wrong "match" visible, which no threshold can. On a creation only the
                             captured side shows: see ShowIconComparison. -->
                        <!-- **No MaxWidth on this panel**: the two tiles are 380px wide together at 4x (a 45x52
                             captured strip and a 40x40 wiki file, plus borders and the gap), so any bound below
                             that silently clips the wiki icon rather than wrapping it — which a 320 here did, at
                             about two thirds of the second tile (user, 2026-10-01). The icons set the column's
                             width; only the prose below is bounded, and at the same 380 so the column reads
                             straight. -->
                        <StackPanel Margin="20,2,0,0"
                                    Visibility="{Binding HasIcons, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Icon" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding IconVerdict}" Foreground="{Binding IconVerdictBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" MaxWidth="380" HorizontalAlignment="Left"
                                       Visibility="{Binding ShowIconComparison, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding IconColumnHint}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                       MaxWidth="380" HorizontalAlignment="Left"
                                       Visibility="{Binding HasIconColumnHint, Converter={StaticResource BoolToVis}}" />
                            <!-- Wraps rather than clips: three tiles need ~560px, more than the content column has at the minimum
                                 window width (rendered, 2026-10-07). -->
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="In game" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <!-- Collapsed when there is no image, rather than left as an empty Border: its
                                         near-black background renders as a small dark rectangle that looks exactly
                                         like a corrupt icon, which is how a null here got reported as a capture bug
                                         (user, 2026-09-29). An absent icon has to look absent. -->
                                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasCapturedIcon, Converter={StaticResource BoolToVis}}">
                                        <!-- Fitted into the same box as the wiki file (user, 2026-10-07). The
                                             strip is a little larger than a 40x40 file, so drawn at the same 4x it
                                             came out bigger and the pair looked unbalanced. -->
                                        <Image x:Name="CapturedIconImage" Stretch="Uniform" Margin="4"
                                               Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Text="not captured" FontSize="11" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic"
                                               Visibility="{Binding HasNoCapturedIcon, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8"
                                            Visibility="{Binding ShowIconComparison, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="On the wiki" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasWikiIcon, Converter={StaticResource BoolToVis}}">
                                        <Image x:Name="WikiIconImage" Stretch="Uniform" Margin="4"
                                               Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="none on the page" FontSize="11" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic"
                                               Visibility="{Binding HasNoWikiIcon, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- The icon the library matched, beside the captured one. **This tile is the whole
                                     safety argument for writing lucy_img_ID automatically**: the match is perceptual
                                     and no threshold separates a lucky win from a real one, so the user confirming by
                                     eye is what makes a 96.7% identifier safe to act on. -->
                                <!-- **The gap before this tile is not decoration**: its Border paints a background,
                                     and with no gap it overpaints the last letter of the wiki column's "none on the
                                     page" label, which is wider than the tile above it (rendered, 2026-10-02). Every
                                     tile now carries the gap on its right rather than this one on its left, so a
                                     tile that wraps to a new line starts flush (rendered, 2026-10-07). -->
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding ShowMatchedIcon, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding MatchedIconCaption}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <Border BorderBrush="{Binding MatchedIconBorderBrush}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasMatchedIcon, Converter={StaticResource BoolToVis}}">
                                        <Image x:Name="MatchedIconImage" Stretch="Uniform" Margin="4"
                                               Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </StackPanel>
                            </WrapPanel>

                            <!-- One button, two jobs. On a creation it publishes the file the generated id already
                                 names; on an existing page whose icon is wrong it does whatever is needed to point
                                 the page at the right one — uploading first when the wiki lacks the file, which it
                                 does for 93% of the library. Both say what they will do before they do it. -->
                            <StackPanel Margin="0,8,0,0" MaxWidth="380" HorizontalAlignment="Left"
                                        Visibility="{Binding CanActOnIcon, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding IconActionPrompt}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <!-- The label is a TextBlock rather than string Content because **a Button eats an
                                     underscore**: WPF reads it as an access-key prefix, so binding the file name
                                     directly rendered "Upload Item3327.png" for a file actually called
                                     Item_3327.png — a wrong file name on the one button whose whole job is to say
                                     which file it publishes. Caught by rendering it; invisible in the XAML. -->
                                <Button Click="OnIconActionClick" HorizontalAlignment="Left" Padding="10,4"
                                        IsEnabled="{Binding IsNotBusy}">
                                    <TextBlock Text="{Binding IconActionButtonText}" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding IconUploadOutcome}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       MaxWidth="380" HorizontalAlignment="Left"
                                       Foreground="{Binding IconUploadOutcomeBrush}"
                                       Visibility="{Binding HasIconUploadOutcome, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Warnings first and unmissable. A flagged gap is the product here; silently-wrong data on a
                         public wiki is the failure this whole tool exists to avoid. -->
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,12,0,0"
                                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource NoticeWarnBackBrush}" BorderBrush="{StaticResource NoticeWarnBorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource NoticeWarnTextBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="What differs" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}" />
                    <!-- PreviewMouseWheel: a DataGrid has its own ScrollViewer, which swallows the wheel even when
                         it has nothing to scroll, so the page under the cursor would not move (user, 2026-09-28). -->
                    <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrushKey}" HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnPassScrollToPage"
                              Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="1.2*" />
                            <!-- Template columns so the compared values wrap. As text columns they truncated, which
                                 hid the very thing the row exists to show — an effect line or a lore paragraph is
                                 far wider than a cell. -->
                            <DataGridTemplateColumn Header="In game" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Captured}" TextWrapping="Wrap" Margin="2,3" Style="{StaticResource ItemData}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="On the wiki" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OnWiki}" TextWrapping="Wrap" Margin="2,3" Style="{StaticResource ItemData}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="Auto" />
                            <!-- A template column so the note wraps. As a text column it truncated mid-sentence,
                                 which loses the part explaining *why* the tool concluded what it did. -->
                            <DataGridTemplateColumn Header="Note" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="2,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Foreground" Value="{Binding Foreground}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- One lore region, always in the same place: the prompt to capture the Lore tab, the lore once
                         captured, and the comparison against the page all live here rather than the lore capture
                         taking over the whole screen (user, 2026-09-28). -->
                    <StackPanel Visibility="{Binding HasLoreSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Lore" Style="{StaticResource SectionHeading}" />

                        <!-- Waiting for the second capture. The button just captures again, so the user switches
                             tab in game and clicks here — or presses the same hotkey. -->
                        <Border Visibility="{Binding WantsLoreCapture, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource NoticeWarnBackBrush}" BorderBrush="{StaticResource NoticeWarnBorderBrush}" BorderThickness="1" CornerRadius="3"
                                Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource NoticeWarnTextBrush}"
                                           Text="This item has a Lore tab that has not been captured yet. Switch to it in game, then:" />
                                <Button Content="Capture the Lore tab" Click="OnCaptureClick" Padding="12,4"
                                        Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Captured, and the page has none to compare against — it will be added by the edit. -->
                        <Border Visibility="{Binding HasCapturedLoreOnly, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3" Padding="8">
                            <StackPanel>
                                <TextBlock Text="In game (captured)" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding CapturedLore}" TextWrapping="Wrap" Style="{StaticResource ItemData}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- The comparison, when the page already has lore of its own. The tool never overwrites it, so
                         this is purely "do you still like what the page says?". -->
                    <StackPanel Visibility="{Binding HasLoreToCompare, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,6"
                                   Text="The page's lore and the captured lore differ. The tool does not overwrite lore, so the page keeps its own wording unless you change it by hand." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3"
                                    Padding="8" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="On the wiki (kept)" FontWeight="SemiBold" Foreground="{StaticResource DoneBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding LoreOnWiki}" TextWrapping="Wrap" Style="{StaticResource ItemData}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3"
                                    Padding="8" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="In game (captured)" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding LoreInGame}" TextWrapping="Wrap" Style="{StaticResource ItemData}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="The edit" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}" />
                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Diff}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding Background}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LineNumbers}" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="4,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas"
                                                   FontSize="12" Foreground="{Binding Foreground}"
                                                   TextWrapping="Wrap" Margin="0,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Expander Header="Edit the wikitext before saving" Margin="0,10,0,0"
                              Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Wikitext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" Height="260" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                    </Expander>

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Edit summary" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"
                                 FontFamily="Consolas" FontSize="12" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save to the wiki" Click="OnCommitClick" Padding="14,5"
                                    FontWeight="SemiBold" IsEnabled="{Binding CanAct}" />
                            <Button Content="Skip for now" Click="OnSkipClick" Padding="14,5" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanSkip}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- **A creation shows its wikitext outright, not behind an Expander** (user, 2026-10-01).
                         There is no original to diff against, so the generated page is not a detail to drill into —
                         it is the whole thing being reviewed, and it must not be collapsible. -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding IsCreation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="The page to create" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                   Text="Generated from the blueprint and laid out already, so this should need no second formatting edit. Everything the capture cannot know — where the item drops, who sells it, which quests use it — is left blank for you." />
                        <TextBox Text="{Binding Wikitext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" Height="320" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />

                        <TextBlock Text="Edit summary" Style="{StaticResource SectionHeading}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"
                                 FontFamily="Consolas" FontSize="12" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Create the page" Click="OnCreateClick" Padding="14,5"
                                    FontWeight="SemiBold" IsEnabled="{Binding CanCreatePage}" />
                            <Button Content="Skip for now" Click="OnSkipClick" Padding="14,5" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanSkip}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The only way a flagged item becomes done. Without it, an item whose page the user has
                         decided is correct stays flagged and re-fetches on every capture forever. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding CanMarkChecked, Converter={StaticResource BoolToVis}}">
                        <Button Content="The wiki is right — mark as checked" Click="OnMarkCheckedClick" Padding="14,5" />
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   MaxWidth="520"
                                   Text="Records this item as matched without changing the page — for a value the page states better than the game does, or anything flagged above that you have judged yourself. It stops coming back unless the item itself changes." />
                    </StackPanel>

                    <TextBlock Text="{Binding Outcome}" Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" />

                    <!-- The formatting follow-up: its own edit, never folded into the data one, because a single
                         reformatting commit with no data changes is what makes page history reviewable. -->
                    <StackPanel Visibility="{Binding HasFormatting, Converter={StaticResource BoolToVis}}"
                                Margin="0,18,0,0">
                        <Border Background="{StaticResource NoticeInfoBackBrush}" BorderBrush="{StaticResource NoticeInfoBorderBrush}" BorderThickness="1" CornerRadius="3"
                                Padding="10,7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource NoticeInfoTextBrush}"
                                           Text="The page can also be tidied — as a separate edit" />
                                <!-- Worded for both cases: after a data edit, and on a page whose data already
                                     agreed, where there is no edit above to keep readable (user, 2026-09-29). -->
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NoticeInfoBodyBrush}" Margin="0,3,0,0"
                                           Text="Laid out to the Item Page Blueprint. It changes nothing about what the page says, and stays its own commit so that a reflow never hides a data change in the page's history." />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding FormattingDiff}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="{Binding Background}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LineNumbers}" FontFamily="Consolas"
                                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="4,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas"
                                                       FontSize="12" Foreground="{Binding Foreground}"
                                                       TextWrapping="Wrap" Margin="0,0,4,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Editable for the same reason the data edit is: the formatter positions a field it has
                             no rule for as best it can, and the user may want it somewhere else (user,
                             2026-09-28). What is in this box is what gets saved. -->
                        <Expander Header="Edit the formatted wikitext before saving" Margin="0,10,0,0">
                            <TextBox Text="{Binding FormattedWikitext, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Height="260"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Margin="0,6,0,0" />
                        </Expander>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save the formatting" Click="OnCommitFormattingClick" Padding="14,5"
                                    IsEnabled="{Binding CanCommitFormatting}" />
                            <TextBlock Text="{Binding FormattingOutcome}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
