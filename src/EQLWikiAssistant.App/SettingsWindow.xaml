<Window x:Class="EQLWikiAssistant.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Height="720" Width="980" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DarkWindow}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="Prose" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Item data and wikitext are monospaced, the interface is not — the same convention as the main window, and
             for the same reason: in a proportional face I and l are near-identical. -->
        <Style x:Key="ItemData" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- One table shape for every part of the mapping: what the game says, what the wiki writes, and an optional
             note. Shared column widths keep each table aligned without a DataGrid, which inside a scrolling page
             swallows the mouse wheel. -->
        <DataTemplate x:Key="MappingRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Game" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Wiki" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Game}" Style="{StaticResource ItemData}" Margin="0,0,24,0" />
                <!-- Capped and wrapping, or one long value (the parameter order) widens the shared column until the
                     note beside it wraps a character per line — measured at a 6,900px-tall page before this. -->
                <TextBlock Grid.Column="1" Text="{Binding Wiki}" Style="{StaticResource ItemData}" Margin="0,0,24,0"
                           Foreground="{Binding WikiBrush}" TextWrapping="Wrap" MaxWidth="340" />
                <TextBlock Grid.Column="2" Text="{Binding Note}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDimBrush}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="MappingTable" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource MappingRow}" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" IsCancel="True" Padding="16,4" MinWidth="80" />
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis">
                    <Hyperlink Click="OnOpenSettingsFolderClick">
                        <TextBlock x:Name="SettingsPathText" />
                    </Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>

        <ListBox x:Name="PageList" DockPanel.Dock="Left" Width="180" BorderThickness="0,0,1,0" Padding="0,8"
                 SelectionChanged="OnPageSelected">
            <ListBoxItem Content="UI font" Padding="12,6" />
            <ListBoxItem Content="Capture hotkey" Padding="12,6" />
            <ListBoxItem Content="Saved captures" Padding="12,6" />
            <ListBoxItem Content="Wiki account" Padding="12,6" />
            <ListBoxItem Content="Wiki mapping" Padding="12,6" />
        </ListBox>

        <Grid>
            <!-- ============================ UI font ============================ -->
            <ScrollViewer x:Name="FontPage" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>
                    <TextBlock Text="UI font" Style="{StaticResource PageHeading}" />
                    <TextBlock Style="{StaticResource Prose}"
                               Text="The font the game draws its interface in. Set this to whatever the game is using: the tool reads item windows letter by letter, and the font decides how it reads a bare vertical stroke." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="The game draws in" VerticalAlignment="Center" />
                        <ComboBox x:Name="FontBox" Width="220" Margin="10,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="OnFontChanged" />
                        <TextBlock x:Name="FontSavedText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource DoneBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="FontDescription" Style="{StaticResource Prose}" Margin="0,14,0,0" />

                    <TextBlock Text="If the setting is wrong" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource Prose}"
                               Text="A window drawn in the other font is refused and shown as Wrong font rather than read, so a mismatch is never silent. Nothing is recorded for a refused window: switch the setting or the game's font, and capture again." />
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Capture hotkey ============================ -->
            <ScrollViewer x:Name="HotKeyPage" VerticalScrollBarVisibility="Auto" Padding="24,18" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Capture hotkey" Style="{StaticResource PageHeading}" />
                    <TextBlock Style="{StaticResource Prose}"
                               Text="Captures the game window from anywhere, so you never have to leave the game. Choose a combination the game does not use: Windows hands the keystroke to this tool, and the game never sees it." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <!-- Shows the live hotkey, or while recording the keys held so far. -->
                        <Border x:Name="HotKeyBox" Background="{StaticResource SunkenBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource BorderStrongBrush}" Padding="12,5" MinWidth="220">
                            <TextBlock x:Name="HotKeyText" FontWeight="SemiBold" FontSize="14" />
                        </Border>
                        <Button x:Name="ChangeHotKeyButton" Content="Change…" Click="OnChangeHotKeyClick" MinWidth="80"
                                Padding="12,4" Margin="10,0,0,0" />
                        <Button x:Name="ResetHotKeyButton" Click="OnResetHotKeyClick" Padding="12,4" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="HotKeyStatus" Style="{StaticResource Prose}" Margin="0,12,0,0" />

                    <TextBlock Text="Which combinations work" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource Prose}"
                               Text="It needs Ctrl, Alt or Win, so it can never fire while you type in chat. If another program already uses the combination, Windows refuses it and your current hotkey keeps working. The Capture now button works whatever happens here." />
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Saved captures ============================ -->
            <ScrollViewer x:Name="CapturesPage" VerticalScrollBarVisibility="Auto" Padding="24,18" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Saved captures" Style="{StaticResource PageHeading}" />
                    <TextBlock Style="{StaticResource Prose}"
                               Text="Keeps a copy of each captured screenshot, named after the items in it, so a problem can be reported by naming the item instead of going back into the game for it." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="KeepCapturesBox" Content="Keep a copy of each capture" VerticalAlignment="Center"
                                  Checked="OnKeepCapturesChanged" Unchecked="OnKeepCapturesChanged" />
                        <TextBlock x:Name="KeepCapturesSavedText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource DoneBrush}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Prose}" Margin="0,14,0,0">
                        <Hyperlink Click="OnOpenCapturesFolderClick">
                            <Run x:Name="CapturesFolderText" />
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="What is kept" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource Prose}"
                               Text="The whole game window, exactly as captured: other players' names and chat included. The copies stay in this folder on this computer and nothing sends them anywhere. Only the newest 50 are kept. Turning this off keeps the ones already saved; delete them from the folder if you want them gone." />
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Wiki account ============================ -->
            <ScrollViewer x:Name="AccountPage" VerticalScrollBarVisibility="Auto" Padding="24,18" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Wiki account" Style="{StaticResource PageHeading}" />
                    <TextBlock Style="{StaticResource Prose}"
                               Text="Reading the wiki needs no account. Saving an edit, creating a page or uploading an icon does: the tool logs in with a bot password the first time it writes. The password is kept in Windows Credential Manager, never in a file." />

                    <TextBlock Text="Stored login" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="StoredText" Style="{StaticResource Prose}" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="SessionText" Style="{StaticResource Prose}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CheckStoredButton" Content="Check it" Click="OnCheckStoredClick" Padding="12,4"
                                ToolTip="Log in with the stored bot password and ask the wiki what it may do. Writes nothing." />
                        <Button x:Name="RemoveStoredButton" Content="Remove it" Click="OnRemoveStoredClick" Padding="12,4" Margin="8,0,0,0"
                                ToolTip="Delete the stored bot password from Windows Credential Manager" />
                    </StackPanel>

                    <TextBlock Text="Enter a bot password" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource Prose}">
                        <Run Text="Create one at" />
                        <Hyperlink Click="OnBotPasswordsClick">Special:BotPasswords</Hyperlink><Run Text=". Grant it" />
                        <Run Text="Edit existing pages" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text=", and also" />
                        <Run Text="Create, edit, and move pages" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run Text="for new items and" />
                        <Run Text="Upload new files" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run Text="for icons. It is checked against the wiki before it is stored, and a password the wiki rejects is not stored." />
                    </TextBlock>

                    <Grid Margin="0,12,0,0" HorizontalAlignment="Left" Width="460">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Bot user name" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox x:Name="UserNameBox" Grid.Column="1" Padding="4,3" FontFamily="Consolas"
                                 ToolTip="The full User@BotName form shown on Special:BotPasswords" />
                        <TextBlock Grid.Row="1" Text="Bot password" VerticalAlignment="Center" Margin="0,8,12,0" />
                        <PasswordBox x:Name="PasswordInput" Grid.Row="1" Grid.Column="1" Padding="4,3" Margin="0,8,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveCredentialButton" Content="Check and save" Click="OnSaveCredentialClick"
                                Padding="12,4" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- What the wiki said, from either button. Each right on its own line, because the one the user
                         is missing is the one they need to see. -->
                    <StackPanel x:Name="CheckPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="CheckHeadline" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="640"
                                   HorizontalAlignment="Left" />
                        <ItemsControl x:Name="RightsList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left">
                                        <Run Text="{Binding Mark, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Wiki mapping ============================ -->
            <ScrollViewer x:Name="MappingPage" VerticalScrollBarVisibility="Auto" Padding="24,18" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Wiki mapping" Style="{StaticResource PageHeading}" />
                    <TextBlock x:Name="MappingIntro" Style="{StaticResource Prose}" />

                    <TextBlock Text="Stats: what the game shows, and what the wiki writes" Style="{StaticResource SectionHeading}" />
                    <ItemsControl x:Name="StatsTable" Style="{StaticResource MappingTable}" />

                    <TextBlock Text="Statsblock line order" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource Prose}" Margin="0,0,0,6"
                               Text="How the formatting pass lays the statsblock out. Labels on one row share a line; a label with no place here keeps its own line before Class." />
                    <ItemsControl x:Name="LineOrderList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource ItemData}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Effects" Style="{StaticResource SectionHeading}" />
                    <ItemsControl x:Name="EffectsTable" Style="{StaticResource MappingTable}" />

                    <TextBlock Text="Slots" Style="{StaticResource SectionHeading}" />
                    <ItemsControl x:Name="SlotsTable" Style="{StaticResource MappingTable}" />

                    <TextBlock Text="Categories" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource Prose}" Margin="0,0,0,6"
                               Text="Categories the tool derives from a capture and adds when missing. It never removes one, and every other category on a page is left alone. A class category is only earned by an item with a slot." />
                    <ItemsControl x:Name="CategoriesTable" Style="{StaticResource MappingTable}" />

                    <TextBlock Text="Template" Style="{StaticResource SectionHeading}" />
                    <ItemsControl x:Name="TemplateTable" Style="{StaticResource MappingTable}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
