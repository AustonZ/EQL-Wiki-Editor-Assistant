<Window x:Class="EQLWikiAssistant.App.LedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLWikiAssistant.App"
        mc:Ignorable="d"
        Title="History" Height="700" Width="1050"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DarkWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- A grid only so the in-app dialog can sit over everything. -->
    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <!-- The count of things still wanting a human comes first and in its own colour: it is the number
                     the user opened this window to read. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AttentionText" FontWeight="SemiBold" Foreground="{StaticResource AttentionBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Show" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox x:Name="FilterBox" Width="200" Margin="6,0,0,0" VerticalAlignment="Center"
                              SelectionChanged="OnQueryChanged" />
                    <TextBlock Text="Search" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="18,0,0,0" />
                    <TextBox x:Name="SearchBox" Width="240" Margin="6,0,0,0" Padding="4,3" VerticalAlignment="Center"
                             TextChanged="OnQueryChanged"
                             ToolTip="Matches the in-game name or the wiki page title" />
                    <TextBlock x:Name="ShownText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Padding="16,4" MinWidth="80" />
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis">
                    <Hyperlink Click="OnOpenLedgerFolderClick">
                        <TextBlock x:Name="LedgerPathText" />
                    </Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" CanUserSortColumns="True"
                      CanUserReorderColumns="False" CanUserResizeColumns="True"
                      SelectionMode="Single" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding CheckedExactly}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Item" Width="1.4*" SortMemberPath="ItemName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3">
                                    <!-- The name is the link to the page (user, 2026-10-07), in place of an
                                         "Open page" button on every row. A row for an item not on the wiki has no
                                         page, so its name is plain text. -->
                                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding HasPageUrl, Converter={StaticResource BoolToVis}}">
                                        <Hyperlink Click="OnOpenPageClick" ToolTip="Open this item's page on the wiki">
                                            <Run Text="{Binding ItemName, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ItemName}" FontFamily="Consolas" FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasNoPageUrl, Converter={StaticResource BoolToVis}}" />
                                    <!-- Only when it differs from the in-game name, which is the case worth
                                         seeing: the page a human had to name by hand. -->
                                    <TextBlock Text="{Binding PageTitle}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Outcome" Width="Auto" SortMemberPath="Outcome">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeBrush}"
                                           FontWeight="SemiBold" Margin="6,3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="Auto" />

                    <!-- What the next capture will do with this row, asked of the ledger itself rather than
                         inferred here. It is what explains a re-check the user did not expect. -->
                    <DataGridTemplateColumn Header="Next capture" Width="1.5*" SortMemberPath="NextCapture">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NextCapture}" Foreground="{Binding NextCaptureBrush}"
                                           TextWrapping="Wrap" Margin="6,3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="Auto"
                                        FontFamily="Consolas" FontSize="11" />

                    <DataGridTemplateColumn Header="" Width="Auto">
                        <!-- The full height of the row, so the cross sits centred and is easy to hit — the same fix as
                             the main window's close buttons (user, 2026-10-07). The theme's cell pins its content to
                             the top, so this column gets a cell that stretches it instead. -->
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Stretch" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- The permanent form of "re-check anyway": forget the row and the next capture
                                     treats the item as new. An icon rather than a button (user, 2026-10-07), since
                                     nothing on the wiki changes. -->
                                <Button Content="✕" Click="OnForgetClick" Style="{StaticResource QuietButton}"
                                        Padding="8,0" Margin="4,0" VerticalAlignment="Stretch"
                                        ToolTip="Forget this item, so the next capture checks it again from scratch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
        <local:OverlayDialog x:Name="Dialog" />
    </Grid>
</Window>
