<UserControl x:Class="EQLWikiAssistant.App.OverlayDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
    <!-- The dimmed backdrop takes every click, which is what makes the window modal while this is up: nothing under
         it can be pressed. Keyboard focus is kept inside the card by cycling its tab order. -->
    <Grid Background="#B0000000">
        <Border x:Name="Card" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="6" Padding="22,18,22,16" MinWidth="340" MaxWidth="520"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                <!-- Selectable, so an error can be copied into a bug report. Styled as text, not as a field. -->
                <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                         BorderThickness="0" Padding="0" Margin="-2,0,0,0" IsTabStop="False"
                         MaxHeight="360" VerticalScrollBarVisibility="Auto" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Click="OnCancelClick" Padding="14,5" MinWidth="80" Margin="0,0,8,0" />
                    <Button x:Name="ConfirmButton" Click="OnConfirmClick" Padding="14,5" MinWidth="80" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
