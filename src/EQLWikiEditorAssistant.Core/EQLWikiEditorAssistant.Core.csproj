<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI font atlas ships inside Core so the glyph reader needs no file beside the executable. It is
         generated by `GlyphSpike atlas` from the in-game Notes Window glyph sheet - see CLAUDE.md before
         regenerating. One per supported UI scale: eql-ui-font.atlas at 1.00, eql-ui-font-2x.atlas and so on above. -->
    <EmbeddedResource Include="Glyphs\eql-ui-font.atlas" />
    <EmbeddedResource Include="Glyphs\eql-ui-font-2x.atlas" />
    <EmbeddedResource Include="Glyphs\eql-ui-font-3x.atlas" />
    <EmbeddedResource Include="Glyphs\eql-ui-font-4x.atlas" />
    <!-- The part of the ENABLE word list that Arial's l/I decision asks about (BarWords). Public
         domain, not MIT: see REUSE.toml. -->
    <EmbeddedResource Include="Glyphs\enable-i-l-words.txt" />
  </ItemGroup>

</Project>
