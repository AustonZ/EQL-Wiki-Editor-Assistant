<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI font atlas ships inside Core so the glyph reader needs no file beside the executable (contrast
         RapidOcrNet's .onnx models, which do and caused a real runtime failure). It is generated by
         `GlyphSpike atlas` from the in-game Notes Window glyph sheet - see CLAUDE.md before regenerating. -->
    <EmbeddedResource Include="Glyphs\eql-ui-font.atlas" />
  </ItemGroup>

</Project>
