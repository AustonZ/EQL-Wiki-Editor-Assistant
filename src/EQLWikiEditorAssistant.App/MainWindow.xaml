<Window x:Class="EQLWikiEditorAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLWikiEditorAssistant.App"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="{x:Static local:AppInfo.Name}" Height="900" Width="1320" MinWidth="700" MinHeight="400"
        Style="{StaticResource DarkWindow}">
    <!-- 1320 wide, not narrower (user, 2026-10-09): below a window width of about 1307 the wiki's own skin lays the
         Preview page's item box out badly. That is the wiki's stylesheet, not ours, but a tester meeting it on first
         launch would reasonably blame the Assistant. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- **Item data and wikitext are monospaced; the interface is not** (user, 2026-09-28). Two reasons, and the
             first is correctness: in a proportional face `I` and `l` are near-identical, so the tool would report a
             lore difference the user could not see — real case, `Black Chain Bridle`. The second is that it makes
             plain at a glance which text is going to, or coming from, the wiki and which is just the app talking. -->
        <Style x:Key="ItemData" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Text the user may want to copy, drawn like a label: read-only, no box, no border, wrapping (user,
             2026-10-07). The first click selects it all. The wheel is passed on, since a text box's own scroller would
             otherwise swallow it and stop the page scrolling under the cursor. -->
        <Style x:Key="SelectableItemData" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="local:Behaviors.SelectAllOnFirstClick" Value="True" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnPassScrollToParent" />
        </Style>

        <!-- The screenshot pane, sized so a window is always shown at its native size, scrollbar or not (user,
             2026-10-07): the 16px left margin, the widest default-size item window (408px, measured), 8px between it
             and the scrollbar, and the theme's 12px scrollbar. At 430 a Description and a Lore capture together made the
             scrollbar appear and the window shrank a few pixels to fit beside it, which reads as blur.
             A window the player has resized wider scrolls sideways rather than shrinking. -->
        <sys:Double x:Key="ShotPaneWidth">450</sys:Double>

        <!-- One size for every icon tile: a 40x40 wiki file at 4x. -->
        <sys:Double x:Key="IconTileSize">160</sys:Double>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <!-- A grid only so the in-app dialog can sit over everything. -->
    <Grid>
    <DockPanel>
        <!-- A plain header rather than a ToolBar: WPF's ToolBar restyles a CheckBox into a flat toggle with no box,
             which makes a setting look like a button, and adds an overflow chevron that never has anything in it. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="10,7">
            <!-- **Solid buttons are for actions; everything else is a link or an icon** (user, 2026-10-07). Capture is
                 the one action here. History and Settings only open a window, so they read as navigation. The global
                 "Re-check anyway" box is gone: an item the ledger let skip the wiki offers its own Re-check link. -->
            <DockPanel LastChildFill="False">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="OnSettingsClick"
                        Style="{StaticResource QuietButton}" Foreground="{StaticResource TextMutedBrush}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Content="&#xE713;"
                        Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Settings" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Hyperlink x:Name="LedgerLink" Click="OnLedgerClick"
                               ToolTip="Everything checked so far, and what still needs attention">History</Hyperlink>
                </TextBlock>
                <!-- Shown only when a newer release is out. An installed copy can update itself (AppUpdater); any
                     other build only links to the release's page, so InstallUpdateSpan is removed there. -->
                <TextBlock x:Name="UpdatePanel" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                           Visibility="Collapsed"><Run x:Name="UpdateRun" Foreground="{StaticResource NewsBrush}"
                    /><Run Text=" — " /><Span x:Name="InstallUpdateSpan"><Hyperlink Click="OnInstallUpdateClick"
                        ToolTip="Download it, then restart on the new version">Update</Hyperlink><Run Text=" · "
                    /></Span><Hyperlink Click="OnReleasePageClick"
                        ToolTip="The release's notes and downloads, on GitHub">What's new</Hyperlink></TextBlock>

                <Button x:Name="CaptureButton" Click="OnCaptureClick" Padding="12,4" FontWeight="SemiBold"
                        Content="Capture now" ToolTip="Capture the game window and check every item window in it" />
                <!-- Beside the button it is the shortcut for (user, 2026-10-07), and a link straight to the page that
                     changes it. -->
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                    <Hyperlink x:Name="HotKeyLink" Click="OnHotKeyLinkClick"><Run x:Name="HotKeyRun" /></Hyperlink>
                </TextBlock>

                <!-- A capture takes tens of seconds, most of it the full-frame OCR pass. A disabled button and a
                     status line were too quiet to read as "working" (user, 2026-09-28). -->
                <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Margin="20,0,0,0" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="BusyLabel" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <!-- The attention count opens History filtered to exactly those rows (user, 2026-10-07). -->
                <TextBlock Foreground="{StaticResource TextMutedBrush}">
                    <Run x:Name="LedgerTotalRun" /><Run x:Name="LedgerSeparatorRun" /><Hyperlink
                        x:Name="AttentionLink" Click="OnAttentionClick"
                        ToolTip="Show them in History"><Run x:Name="AttentionRun" /></Hyperlink>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Every window found in the frame, including the ones nothing could be done with: a window the tool
                 refused is exactly what the user needs to be told about. -->
            <DockPanel Grid.Column="0">
            <!-- Closing everything at once, for the end of a session. Like closing one, it changes nothing on the
                 wiki or in the ledger: a tab is only a view of a capture. -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,1"
                    Padding="8,4" x:Name="ResultsHeader" Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Right">
                    <Hyperlink Click="OnCloseAllClick" ToolTip="Close every item">Close all</Hyperlink>
                </TextBlock>
            </Border>
            <!-- No horizontal scrolling: a long name or status is trimmed instead, so the close button always stays
                 in view at the column's narrower width (user, 2026-10-07). -->
            <ListBox x:Name="ResultsList" SelectionChanged="OnResultSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrushKey}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,0" ToolTip="{Binding CaptureTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The item's own icon, so the list can be scanned by picture (user, 2026-10-07). The
                                 slot keeps its width when there is none — a Lore-only capture — so names line up. -->
                            <Image Grid.Column="0" Source="{Binding TabIcon}" Width="28" Height="28" Margin="0,0,8,0"
                                   Stretch="Uniform" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="0,5">
                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <!-- A settled item reads green here rather than keeping its orange status with a
                                     grey marker beside it: the list is scanned to find what still needs attention, so
                                     done is what has to be obvious (user, 2026-09-29). -->
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                           FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusText}" />
                            </StackPanel>
                            <!-- The list accumulates across captures, so finishing with an item has to be an
                                 explicit act rather than something the next capture does for you. -->
                            <!-- The full height of the row, so the cross sits centred and is easy to hit (user,
                                 2026-10-07). The row's vertical margin lives on the text for the same reason. -->
                            <Button Grid.Column="2" Content="✕" Click="OnCloseResultClick" Padding="8,0"
                                    Style="{StaticResource QuietButton}"
                                    VerticalAlignment="Stretch" ToolTip="Close this item" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- Shown only when nothing is selected. It is a separate element rather than a placeholder inside the
                 detail panel because a binding against a null DataContext cannot resolve at all: WPF then falls back
                 to the property's default, and every `Visibility` below silently reverts to Visible — which rendered
                 the entire empty scaffold, lore panel and buttons included. -->
            <TextBlock Grid.Column="2" x:Name="EmptyState" TextWrapping="Wrap" MaxWidth="420" Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="Open an item window in game and press Ctrl+Shift+E, or press Capture now.&#10;&#10;Every item window in the capture is checked against the wiki and listed on the left." />

            <!-- **The screenshot has its own pane, left of the edit pane** (user, 2026-10-07): fixed width, no border on
                 the side it shares, and it never scrolls away with the edit, so the window being reviewed stays in
                 view and the warnings no longer sit underneath it. When the area is too narrow for both side by side,
                 the screenshot moves to the top of the edit pane instead — see OnDetailAreaSizeChanged. -->
            <Grid Grid.Column="2" x:Name="DetailArea" Visibility="Collapsed" SizeChanged="OnDetailAreaSizeChanged"
                  DataContext="{Binding SelectedItem, ElementName=ResultsList}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" x:Name="ShotPane" Width="{StaticResource ShotPaneWidth}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShotPaneHost" Margin="16,10,8,16">
                        <!-- Moved between this pane and the top of the edit pane as the width changes. -->
                        <StackPanel x:Name="ShotStack">
                            <!-- The item's name, status and page link head the screenshot rather than the edit (user,
                                 2026-10-07), so they stay in view with it. The status row wraps, the pane being
                                 narrower than the edit pane it came from. -->
                            <!-- The verification badge beside the name rather than a bar in the warning strip (user,
                                 2026-10-07): it is about the page as a whole, not something to act on in this edit. -->
                            <WrapPanel>
                                <!-- Selectable, for copying the name (user, 2026-10-07), and otherwise a label: read-only,
                                     no box, no border. The -2 cancels the text box's own inner inset so the name still
                                     lines up with the status below it. -->
                                <TextBox Text="{Binding ItemName, Mode=OneWay}" IsReadOnly="True" FontSize="21"
                                         FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         Margin="-2,0,12,0" />
                                <!-- Clickable (user, 2026-10-07): it explains what it means and offers the page, where
                                     verifying it is done. -->
                                <Border Background="{StaticResource AttentionBrush}" CornerRadius="3" Padding="8,2"
                                        VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OnNotVerifiedClick"
                                        ToolTip="What does this mean?"
                                        Visibility="{Binding Result.NotVerifiedForEql, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Not verified for EQL" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource SurfaceBrush}" />
                                </Border>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LedgerNote}" Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"
                                           Visibility="{Binding HasLedgerNote, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>

                            <!-- The page link reads "Open wiki page" rather than the title (user, 2026-10-07), since the
                                 title is the item's name above it nearly always. Not always: a redirect lands on another
                                 title, so that one is shown beside the link. Re-check shares the line, only where the
                                 ledger let this capture skip the wiki (replacing the global checkbox). Both are links,
                                 since neither writes anything. -->
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Margin="0,0,16,0" Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}">
                                    <Hyperlink Click="OnOpenPageClick" ToolTip="{Binding PageUrl}"><Run
                                        Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" BaselineAlignment="Center" /><Run
                                        Text=" Open wiki page" /></Hyperlink><Run
                                        Text="{Binding PageTitleIfDifferent, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                                </TextBlock>
                                <TextBlock Visibility="{Binding CanReCheck, Converter={StaticResource BoolToVis}}">
                                    <Hyperlink Click="OnReCheckClick"
                                               ToolTip="Compare it against the wiki now, even though nothing has changed since it was checked"><Run
                                        Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" BaselineAlignment="Center" /><Run
                                        Text=" Refresh wiki data" /></Hyperlink>
                                </TextBlock>
                            </WrapPanel>

                            <!-- Says where the pictures came from, since they could otherwise be taken for the wiki's own
                                 (user, 2026-10-07). Plural once the Lore capture joins the Description one. -->
                            <TextBlock x:Name="ShotLabel" Text="Captured screenshot" Style="{StaticResource SectionHeading}"
                                       Margin="0,14,0,4" />

                            <!-- **Always at full size** (user, 2026-10-07): the screenshot is the reference the user reads
                                 the right-hand side against, and a shrunken one loses exactly that. A window wider than
                                 the space — one the player resized, which the game's layouts give no reason to do —
                                 scrolls sideways here instead. Only the screenshots scroll: the name and status above
                                 stay put and keep wrapping to the pane's width. The wheel goes to the page, since this
                                 scroller only ever scrolls sideways. -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="OnPassScrollToParent" Margin="0,4,0,0">
                                <StackPanel>
                                    <Image x:Name="WindowImage" Stretch="None" UseLayoutRounding="True"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <!-- The Lore capture sits below the Description one rather than replacing it, so
                                         both halves of a two-capture item stay visible together. -->
                                    <Image x:Name="LoreImage" Stretch="None" UseLayoutRounding="True"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            <!-- **The edit pane is a step-by-step review** (user, 2026-10-07): a timeline over five pages, one shown at a
                 time and sliding between them — Edit, Preview, Submit, Formatting, Done. The screenshot pane
                 beside it never moves. An item with nothing to step through (occluded, ineligible, already checked, ...)
                 shows the first page alone, with no timeline. -->
            <DockPanel Grid.Column="1" x:Name="EditPane">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1"
                        Padding="12,8" Visibility="{Binding HasReview, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Hit-testable only where going back is allowed, rather than disabled: a disabled
                                         button greys its text, which would hide the step's own colour. -->
                                    <Button Style="{StaticResource QuietButton}" Click="OnStepClick" Padding="4,2"
                                            IsHitTestVisible="{Binding CanJump}" Focusable="{Binding CanJump}"
                                            Cursor="Hand" ToolTip="{Binding Tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                <Ellipse Fill="{Binding Marker}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                    <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
                                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                                    <Setter Property="StrokeDashArray" Value="2 1.6" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding MarkerText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding MarkerForeground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                                       FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <Rectangle Width="22" Height="1" Margin="4,0" VerticalAlignment="Center"
                                               Fill="{StaticResource BorderStrongBrush}"
                                               Visibility="{Binding HasConnector, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- The pages overlap here, one visible at a time; changing page slides one out and the next in. -->
                <Grid x:Name="PageHost" ClipToBounds="True">

            <!-- 1. Edit. -->
            <!-- No padding on the scroller itself: it sat inside the scrolling area, so clipped content stopped short
                 of the border above and below (user, 2026-10-07). The panel's own margin scrolls with it instead. -->
            <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Margin="16,10,16,16">
                    <!-- The name, status and screenshot land here when the area is too narrow for their own pane. -->
                    <StackPanel x:Name="InlineShotHost" Margin="0,0,0,4" Visibility="Collapsed" />

                    <!-- **The capture comes first, above everything else** (user, 2026-10-01): the game is the
                         source, so the panel reads from the source downward towards the finished wikitext. The
                         icons share this row rather than taking a section of their own further down — there is
                         spare width beside a ~400px window crop, and vertical space is what this panel runs out
                         of. A WrapPanel is what makes that safe: on a narrow window the icons drop below the
                         screenshot instead of being clipped. -->
                    <WrapPanel Orientation="Horizontal">

                        <!-- Both icons, whatever the verdict. The comparison is perceptual and has limits — it
                             declines near-black sprites and occasionally flags a good one — and every one of those
                             outcomes is cheap to settle if the user can just look, and expensive if they cannot. It
                             also makes a wrong "match" visible, which no threshold can. On a creation only the
                             captured side shows: see ShowIconComparison. -->
                        <!-- **No MaxWidth on this panel**: the two tiles are 380px wide together at 4x (a 45x52
                             captured strip and a 40x40 wiki file, plus borders and the gap), so any bound below
                             that silently clips the wiki icon rather than wrapping it — which a 320 here did, at
                             about two thirds of the second tile (user, 2026-10-01). The icons set the column's
                             width; only the prose below is bounded, and at the same 380 so the column reads
                             straight. -->
                        <StackPanel Margin="0,2,0,0"
                                    Visibility="{Binding HasIcons, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Icon" Style="{StaticResource SectionHeading}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding IconVerdict}" Foreground="{Binding IconVerdictBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" MaxWidth="380" HorizontalAlignment="Left"
                                       Visibility="{Binding ShowIconComparison, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding IconColumnHint}" TextWrapping="Wrap"
                                       Foreground="{Binding IconColumnHintBrush}" Margin="0,0,0,6"
                                       MaxWidth="380" HorizontalAlignment="Left"
                                       Visibility="{Binding HasIconColumnHint, Converter={StaticResource BoolToVis}}" />
                            <!-- Wraps rather than clips: three tiles need ~560px, more than the content column has at the minimum
                                 window width (rendered, 2026-10-07). -->
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,20,8">
                                    <TextBlock Text="In game" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <!-- Collapsed when there is no image, rather than left as an empty Border: its
                                         near-black background renders as a small dark rectangle that looks exactly
                                         like a corrupt icon, which is how a null here got reported as a capture bug
                                         (user, 2026-09-29). An absent icon has to look absent. -->
                                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasCapturedIcon, Converter={StaticResource BoolToVis}}">
                                        <!-- Fitted into the same box as the wiki file (user, 2026-10-07). The
                                             strip is a little larger than a 40x40 file, so drawn at the same 4x it
                                             came out bigger and the pair looked unbalanced. -->
                                        <Image x:Name="CapturedIconImage" Stretch="Uniform" Margin="4"
                                               Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <!-- An absent icon has to look absent, and now also says so where the icon would be
                                         (user, 2026-10-07). -->
                                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasNoCapturedIcon, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="4" Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}">
                                            <TextBlock Text="No icon found in the capture" TextWrapping="Wrap" TextAlignment="Center"
                                                       VerticalAlignment="Center" Padding="10,0"
                                                       Foreground="{StaticResource AttentionBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,8"
                                            Visibility="{Binding ShowIconComparison, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="On the wiki" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasWikiIcon, Converter={StaticResource BoolToVis}}">
                                        <Image x:Name="WikiIconImage" Stretch="Uniform" Margin="4"
                                               Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasNoWikiIcon, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="4" Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}">
                                            <TextBlock Text="No icon on the wiki" TextWrapping="Wrap" TextAlignment="Center"
                                                       VerticalAlignment="Center" Padding="10,0"
                                                       Foreground="{StaticResource AttentionBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- The icon the library matched, beside the captured one. **This tile is the whole
                                     safety argument for writing lucy_img_ID automatically**: the match is perceptual
                                     and no threshold separates a lucky win from a real one, so the user confirming by
                                     eye is what makes a 96.7% identifier safe to act on. -->
                                <!-- **The gap before this tile is not decoration**: its Border paints a background,
                                     and with no gap it overpaints the last letter of the wiki column's "none on the
                                     page" label, which is wider than the tile above it (rendered, 2026-10-02). Every
                                     tile now carries the gap on its right rather than this one on its left, so a
                                     tile that wraps to a new line starts flush (rendered, 2026-10-07). -->
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding ShowMatchedIcon, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding MatchedIconCaption}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <Border BorderBrush="{Binding MatchedIconBorderBrush}" BorderThickness="1" Background="{StaticResource GameBackdropBrush}"
                                            Visibility="{Binding HasMatchedIcon, Converter={StaticResource BoolToVis}}">
                                        <Image x:Name="MatchedIconImage" Stretch="Uniform" Margin="4"
                                               Width="{StaticResource IconTileSize}" Height="{StaticResource IconTileSize}"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </StackPanel>
                            </WrapPanel>

                            <!-- One button, two jobs. On a creation it publishes the file the generated id already
                                 names; on an existing page whose icon is wrong it does whatever is needed to point
                                 the page at the right one — uploading first when the wiki lacks the file, which it
                                 does for 93% of the library. Both say what they will do before they do it. -->
                            <StackPanel Margin="0,8,0,0" MaxWidth="380" HorizontalAlignment="Left"
                                        Visibility="{Binding CanActOnIcon, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding IconActionPrompt}" TextWrapping="Wrap"
                                           Foreground="{StaticResource AttentionBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding HasIconActionPrompt, Converter={StaticResource BoolToVis}}" />
                                <!-- The label is a TextBlock rather than string Content because **a Button eats an
                                     underscore**: WPF reads it as an access-key prefix, so binding the file name
                                     directly rendered "Upload Item3327.png" for a file actually called
                                     Item_3327.png — a wrong file name on the one button whose whole job is to say
                                     which file it publishes. Caught by rendering it; invisible in the XAML. -->
                                <Button Click="OnIconActionClick" HorizontalAlignment="Left" Padding="10,4"
                                        IsEnabled="{Binding IsNotBusy}">
                                    <TextBlock Text="{Binding IconActionButtonText}" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding IconUploadOutcome}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       MaxWidth="380" HorizontalAlignment="Left"
                                       Foreground="{Binding IconUploadOutcomeBrush}"
                                       Visibility="{Binding HasIconUploadOutcome, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Warnings first and unmissable. A flagged gap is the product here; silently-wrong data on a
                         public wiki is the failure this whole tool exists to avoid. -->
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,12,0,0"
                                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource NoticeWarnBackBrush}" BorderBrush="{StaticResource NoticeWarnBorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource NoticeWarnTextBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The reverse of the Lore tab prompt below (user, 2026-10-07): the Lore tab was captured first,
                         so the item's data is still to come. -->
                    <Border Visibility="{Binding WantsDescriptionCapture, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource NoticeWarnBackBrush}" BorderBrush="{StaticResource NoticeWarnBorderBrush}" BorderThickness="1" CornerRadius="3"
                            Padding="10,7" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NoticeWarnTextBrush}"
                                   Text="This item's Description tab has not been captured yet. Switch to it in game, then capture again." />
                    </Border>

                    <!-- One lore region, always in the same place: the prompt to capture the Lore tab, the lore once
                         captured, and the comparison against the page all live here rather than the lore capture
                         taking over the whole screen (user, 2026-09-28). -->
                    <StackPanel Visibility="{Binding HasLoreSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Lore" Style="{StaticResource SectionHeading}" />

                        <!-- Waiting for the second capture. No button of its own (user, 2026-10-07): capturing again
                             is the hotkey or Capture now, as for any capture, and the button was being clipped. -->
                        <Border Visibility="{Binding WantsLoreCapture, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource NoticeWarnBackBrush}" BorderBrush="{StaticResource NoticeWarnBorderBrush}" BorderThickness="1" CornerRadius="3"
                                Padding="10,7">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NoticeWarnTextBrush}"
                                       Text="This item has a Lore tab that has not been captured yet. Switch to it in game, then capture again." />
                        </Border>

                        <!-- Captured, and the page has none to compare against — it will be added by the edit. -->
                        <Border Visibility="{Binding HasCapturedLoreOnly, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3" Padding="8">
                            <StackPanel>
                                <TextBlock Text="In game (captured)" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding CapturedLore, Mode=OneWay}" Style="{StaticResource SelectableItemData}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- The comparison, when the page already has lore of its own. The tool never overwrites it, so
                         this is purely "do you still like what the page says?". -->
                    <StackPanel Visibility="{Binding HasLoreToCompare, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,6"
                                   Text="The page's lore and the captured lore differ. Lore is never overwritten, so the page keeps its own wording unless you change it by hand." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3"
                                    Padding="8" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="On the wiki (kept)" FontWeight="SemiBold" Foreground="{StaticResource DoneBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding LoreOnWiki, Mode=OneWay}" Style="{StaticResource SelectableItemData}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3"
                                    Padding="8" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="In game (captured)" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding LoreInGame, Mode=OneWay}" Style="{StaticResource SelectableItemData}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Proposed changes" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}" />
                    <!-- PreviewMouseWheel: a DataGrid has its own ScrollViewer, which swallows the wheel even when
                         it has nothing to scroll, so the page under the cursor would not move (user, 2026-09-28). -->
                    <!-- Every cell is selectable text (user, 2026-10-07): the first click selects the whole value, later
                         ones pick out part of it. Rows are never selected, which did nothing useful. The text takes the
                         row's colour, since a text box sets its own foreground rather than inheriting one. -->
                    <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserReorderColumns="False" CanUserResizeColumns="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrushKey}" HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnPassScrollToPage" local:Behaviors.NoRowSelection="True"
                              Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Resources>
                            <Style x:Key="FindingCell" TargetType="TextBox" BasedOn="{StaticResource SelectableItemData}">
                                <Setter Property="Margin" Value="2,3" />
                                <Setter Property="Foreground" Value="{Binding Foreground}" />
                            </Style>
                            <Style x:Key="FindingProse" TargetType="TextBox" BasedOn="{StaticResource FindingCell}">
                                <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Field" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Field, Mode=OneWay}" Style="{StaticResource FindingProse}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- The compared values wrap: an effect line or a lore paragraph is far wider than a cell, and
                                 truncating it hid the very thing the row exists to show. -->
                            <DataGridTemplateColumn Header="In game" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Captured, Mode=OneWay}" Style="{StaticResource FindingCell}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="On the wiki" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding OnWiki, Mode=OneWay}" Style="{StaticResource FindingCell}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Verdict" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Verdict, Mode=OneWay}" Style="{StaticResource FindingProse}"
                                                 TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- The note wraps; truncated mid-sentence it lost the part explaining *why*. -->
                            <DataGridTemplateColumn Header="Note" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Explanation, Mode=OneWay}" Style="{StaticResource FindingProse}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <!-- A row that gets selected regardless (a second click does it) shows nothing: the
                             highlight sat behind the text's own selection and made it hard to read (user, 2026-10-08). -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Focusable" Value="False" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>


                    <!-- **The tool's own proposal as a diff, and the source collapsed beneath it** (user, 2026-10-07). The
                         diff is the edit the tool worked out, fixed when the item was checked; Submit shows the final
                         one, from whatever the editor then holds. The source is there to change it further, and what is
                         in it is what Preview renders and Submit saves. Expanding it brings it into view. -->
                    <StackPanel Visibility="{Binding HasProposedDiff, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Proposed edit" Style="{StaticResource SectionHeading}" />
                        <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3">
                            <local:DiffView Lines="{Binding ProposedDiff}" />
                        </Border>
                    </StackPanel>
                    <Expander x:Name="SourceExpander" Header="Edit wikitext source" Margin="0,14,0,0"
                              Expanded="OnSourceExpanded" IsExpanded="{Binding SourceExpanded}"
                              Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Wikitext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" Height="320" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                    </Expander>

                    <!-- **A creation shows its wikitext outright, not behind an Expander** (user, 2026-10-01).
                         There is no original to diff against, so the generated page is not a detail to drill into —
                         it is the whole thing being reviewed, and it must not be collapsible. -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding IsCreation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="The page to create" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                   Text="Generated from the blueprint. Drops, vendors and quests are left blank for you to fill in." />
                        <TextBox Text="{Binding Wikitext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" Height="320" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Next, or settle it here: "the wiki is right" is the only way a flagged item becomes done, and
                         without it an item whose page the user has decided is correct would come back on every capture
                         forever. Skipping writes nothing to the wiki, so it is a link. -->
                    <WrapPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button Content="Next" Click="OnNextClick" Padding="20,5" Margin="0,0,10,6" FontWeight="SemiBold"
                                IsEnabled="{Binding CanGoNext}"
                                Visibility="{Binding HasReview, Converter={StaticResource BoolToVis}}" />
                        <Button Content="The wiki is right — mark as checked" Click="OnMarkCheckedClick" Padding="14,5"
                                Margin="0,0,10,6"
                                ToolTip="Records the item as checked without changing the page. It comes back only if the item itself changes."
                                Visibility="{Binding CanMarkChecked, Converter={StaticResource BoolToVis}}" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,0,6"
                                   Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Click="OnSkipClick"
                                       ToolTip="Leave it for now. It comes back on the next capture.">Skip for now</Hyperlink>
                        </TextBlock>
                    </WrapPanel>

                    <TextBlock Text="{Binding Outcome}" Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Preview: the wiki's own rendering, asked for only now (see ItemCheckPipeline.PreviewAsync). The browser
                 is a native window WPF cannot draw over, so it is hidden whenever something has to be (a dialog, a
                 slide) and shown once its page has loaded. -->
            <DockPanel x:Name="PreviewPage" Visibility="Collapsed">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back" Click="OnBackClick" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Next" Click="OnPreviewNextClick" Padding="20,5" FontWeight="SemiBold"
                                IsEnabled="{Binding HasChangesToSubmit}" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Margin="16,10,16,8" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="The wiki's own rendering of the text you are about to save. Nothing has been saved." />
                <Grid>
                    <TextBlock x:Name="PreviewStatus" Margin="16,8" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <wv2:WebView2 x:Name="PreviewBrowser" Visibility="Hidden" />
                </Grid>
            </DockPanel>

            <!-- 3. Submit: the last look before anything is written. **This page is the confirmation** (user,
                 2026-10-07): it shows exactly what Save writes, so there is no "are you sure?" after it. -->
            <ScrollViewer x:Name="SubmitPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,10,16,16">
                    <StackPanel x:Name="SubmitShotHost" Margin="0,0,0,4" Visibility="Collapsed" />

                    <TextBlock Text="{Binding SubmitHeading}" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                    <!-- Large, because for a creation the title is the part only the user can judge. -->
                    <TextBox Text="{Binding SubmitTitle, Mode=OneWay}" IsReadOnly="True" FontSize="19" FontWeight="Bold"
                             TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0"
                             Margin="-2,2,0,0" />

                    <Border Background="{StaticResource NoticeWarnBackBrush}" BorderBrush="{StaticResource NoticeWarnBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,10,0,0"
                            Visibility="{Binding HasSubmitNotice, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SubmitNotice}" TextWrapping="Wrap" Foreground="{StaticResource NoticeWarnTextBrush}" />
                    </Border>

                    <TextBlock Text="What will be written" Style="{StaticResource SectionHeading}" />
                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3">
                        <local:DiffView Lines="{Binding Diff}" />
                    </Border>

                    <TextBlock Text="Edit summary" Style="{StaticResource SectionHeading}" />
                    <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"
                             FontFamily="Consolas" FontSize="12" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Back" Click="OnBackClick" Padding="14,5" Margin="0,0,8,0"
                                IsEnabled="{Binding IsNotBusy}" />
                        <!-- A TextBlock rather than string content, so no underscore in it is eaten as an access key. -->
                        <Button Style="{StaticResource WikiWriteButton}" Click="OnSaveClick" IsEnabled="{Binding CanSave}">
                            <TextBlock Text="{Binding SaveButtonText}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Formatting: always its own edit, never folded into the data one, because a reformatting commit with
                 no data changes is what makes page history reviewable. -->
            <ScrollViewer x:Name="FormattingPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,10,16,16">
                    <StackPanel x:Name="FormattingShotHost" Margin="0,0,0,4" Visibility="Collapsed" />

                    <TextBlock Text="{Binding Outcome}" Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" />

                    <TextBlock x:Name="FormattingGood" Text="Formatting looks good." FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource DoneBrush}" Visibility="Collapsed" />

                    <ItemsControl ItemsSource="{Binding FormattingNotes}" Margin="0,8,0,0"
                                  Visibility="{Binding HasFormattingNotes, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource NoticeWarnBackBrush}" BorderBrush="{StaticResource NoticeWarnBorderBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource NoticeWarnTextBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasFormatting, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource NoticeInfoBackBrush}" BorderBrush="{StaticResource NoticeInfoBorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="10,7" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource NoticeInfoTextBrush}"
                                           Text="The page can be tidied — as a separate edit" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NoticeInfoBodyBrush}" Margin="0,3,0,0"
                                           Text="Layout only: nothing the page says changes. Saved as its own edit." />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0">
                            <local:DiffView Lines="{Binding FormattingDiff}" />
                        </Border>

                        <!-- **Collapsed by default** (user, 2026-10-07), to discourage formatting by hand: the formatter is
                             meant to be deterministic and trusted. Still editable, because it has to put a field it has
                             no rule for somewhere and the user may disagree. What is in the box is what gets saved. -->
                        <Expander Header="Raw wikitext" Margin="0,10,0,0">
                            <TextBox Text="{Binding FormattedWikitext, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Height="260"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Margin="0,6,0,0" />
                        </Expander>

                        <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Accept the formatting" Style="{StaticResource WikiWriteButton}"
                                    Click="OnAcceptFormattingClick" Margin="0,0,8,6"
                                    IsEnabled="{Binding CanCommitFormatting}" />
                            <Button Content="Skip" Click="OnSkipFormattingClick" Padding="14,5" Margin="0,0,8,6"
                                    IsEnabled="{Binding IsNotBusy}" ToolTip="Leave the layout as it is" />
                            <Button Content="Make another edit" Click="OnEditAgainClick" Padding="14,5" Margin="0,0,0,6"
                                    IsEnabled="{Binding IsNotBusy}"
                                    ToolTip="Back to the first page, compared afresh against the page as it now stands" />
                        </WrapPanel>
                    </StackPanel>

                    <Button x:Name="FormattingNextButton" Content="Next" Click="OnSkipFormattingClick" Padding="20,5"
                            FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 5. Done: the page as readers now see it. -->
            <DockPanel x:Name="DonePage" Visibility="Collapsed">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Done" Click="OnDoneClick" Padding="20,5" FontWeight="SemiBold" Margin="0,0,8,0"
                                ToolTip="Close this item" />
                        <Button Content="Edit again" Click="OnEditAgainClick" Padding="14,5"
                                IsEnabled="{Binding IsNotBusy}"
                                ToolTip="Back to the first page, compared afresh against the page as it now stands" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="16,10,16,8">
                    <TextBlock Text="{Binding Outcome}" Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding FormattingOutcome}" Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormattingOutcome, Converter={StaticResource BoolToVis}}" />
                    <!-- Repeats the page link under the item's name, here where the page is (user, 2026-10-07: "even
                         I forgot about it"). A link, since it only opens a page. -->
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0">
                            <Hyperlink Click="OnOpenPageClick" ToolTip="{Binding PageUrl}"><Run
                                Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" BaselineAlignment="Center" /><Run
                                Text=" Open in browser" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Text="The page as it now reads on the wiki." Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                </StackPanel>
                <Grid>
                    <TextBlock x:Name="DoneStatus" Margin="16,8" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <wv2:WebView2 x:Name="DoneBrowser" Visibility="Hidden" />
                </Grid>
            </DockPanel>
                </Grid>
            </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
        <local:OverlayDialog x:Name="Dialog" />
    </Grid>
</Window>
