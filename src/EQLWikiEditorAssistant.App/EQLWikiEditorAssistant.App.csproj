<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EQLWikiEditorAssistant.Core\EQLWikiEditorAssistant.Core.csproj" />
    <ProjectReference Include="..\EQLWikiEditorAssistant.Capture\EQLWikiEditorAssistant.Capture.csproj" />
    <ProjectReference Include="..\EQLWikiEditorAssistant.Ocr\EQLWikiEditorAssistant.Ocr.csproj" />
    <ProjectReference Include="..\EQLWikiEditorAssistant.Pipeline\EQLWikiEditorAssistant.Pipeline.csproj" />
    <ProjectReference Include="..\EQLWikiEditorAssistant.Wiki\EQLWikiEditorAssistant.Wiki.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct, not transitive through EQLWikiEditorAssistant.Ocr. RapidOcrNet's bundled .onnx models only reliably copy
         to an executable's own output directory when the executable references the package itself — confirmed the
         hard way twice, most recently by tools/OcrSpike failing at runtime with a missing-model-file error. See
         CLAUDE.md, which flagged this project as needing the same treatment. -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <!-- The review's Preview and Done pages: the wiki's own rendering, in the Edge runtime Windows 11 ships. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- The installer and its uninstall/update hooks. App.Main hands control to it first; see there. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The one home of the name and version: AppInfo reads both, and the wiki edit summaries carry them. Semantic
         Versioning as adapted for this app — see AppInfo. -->
    <Product>EQL Wiki Editor Assistant</Product>
    <Version>1.0.0-alpha.1</Version>
    <ApplicationDisplayName>$(Product)</ApplicationDisplayName>
    <!-- The wiki's logo with a pencil. Windows without an Icon of their own take this one, taskbar included. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- App.Main rather than a generated one, so the installer's hook runs first. -->
    <StartupObject>EQLWikiEditorAssistant.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Shipped beside the executable: the licence, the notices for everything the app is built on, and the two
       components' own notices files that THIRD-PARTY-NOTICES.txt points to. Pinned to the package versions on purpose:
       when a package moves, the copy fails the build instead of shipping a stale notice. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.29.0\ThirdPartyNotices.txt"
          Link="licenses\onnxruntime-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.1\THIRD-PARTY-NOTICES.txt"
          Link="licenses\skiasharp-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
